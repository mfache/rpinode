#!/usr/sbin/nft -f
# Pare-feu du boîtier rpinode (voir README.md de ce dossier).
#
# Table indépendante : /etc/nftables.conf commence par « flush ruleset » et
# n'est chargé qu'au démarrage ; on ne le modifie pas et on ne relance jamais
# nftables.service (cela effacerait aussi les règles de Tailscale).
# Recharger cette table seule : sudo nft -f /etc/rpinode/rpinode-firewall.nft

table inet rpinode_pf
delete table inet rpinode_pf

table inet rpinode_pf {
	chain input {
		# Avant les chaînes de Tailscale (iptables-nft, priorité 0) : un « drop »
		# ici est définitif, un « accept » laisse Tailscale appliquer les siennes.
		type filter hook input priority filter - 10; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto { icmp, ipv6-icmp } accept

		# Tailnet : accès d'administration et proxy du portail docs (/rpi/<boîtier>/).
		iifname "tailscale0" accept
		udp dport 41641 accept comment "Tailscale, liaisons directes"

		udp sport 67 udp dport 68 accept comment "client DHCP"
		udp sport 547 udp dport 546 accept comment "client DHCPv6"

		# 4G : rien d'autre. Si l'opérateur donne une IPv6 publique, le boîtier
		# n'est plus joignable depuis Internet que par Tailscale.
		iifname "wwan0" drop

		# Réseaux du chantier (eth0, wlan0 client). L'interface web n'est
		# joignable que par Tailscale (plus de point d'accès depuis le 2026-10-27).
		udp dport 47808 accept comment "BACnet/IP (I-Am diffusés)"
		tcp dport 22 accept comment "SSH de secours (RPIRESCUE, LAN)"
	}

	chain forward {
		# Routage conservé : LAN du chantier publié sur le tailnet (routes
		# annoncées à headscale par publish_tailscale_routes).
		type filter hook forward priority filter - 10; policy accept;
		ct state established,related accept
		iifname "wwan0" drop
	}
}
