[Unit]
Description=rpinode - Terminal serie Bluetooth (SPP -> login systeme)
After=bluetooth.service bt-agent.service
Requires=bluetooth.service
Wants=bt-agent.service

[Service]
Type=simple
ExecStartPre=/usr/bin/sdptool add --channel=1 SP
ExecStart=/usr/local/bin/rfcomm-pty-terminal
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
