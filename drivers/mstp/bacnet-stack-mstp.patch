+/**
+ * @brief Set the Npoll parameter for this MSTP datalink
+ *
+ * @note Nombre de jetons recus/utilises avant qu'un cycle Poll For Master
+ *  ne soit execute (defaut spec : 50, Errata SSPC-135-2004). Une valeur
+ *  plus faible sonde plus souvent les adresses non-attribuees, ce qui
+ *  accelere la decouverte de nouveaux maitres sur un bus charge, au prix
+ *  d'un peu plus de trafic de scrutation.
+ *
+ * @param npoll - value to be set (0 traite comme 1)
+ */
+void dlmstp_set_npoll(uint8_t npoll)
+{
+    MSTP_Port.Npoll = (npoll == 0) ? 1 : npoll;
+
+    return;
+}
+
+/**
+ * @brief Get the Npoll parameter for this MSTP datalink
+ * @return Npoll value
+ */
+uint8_t dlmstp_npoll(void)
+{
+    return MSTP_Port.Npoll;
+}
