.sync-pending {
    color: #f39c12;
    font-size: 1.1em;
    cursor: help;
    animation: bounce 2s infinite;
}
@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
}
</style>

<script>
    async function startIpScan() {
        const btn = document.getElementById('btn-start-scan');
        const status = document.getElementById('scan-status');
        
        // On récupère le baseUrl dynamiquement
        const baseUrl = window.CONFIG ? window.CONFIG.baseUrl : '/rpinode';
        
        btn.disabled = true;
        status.textContent = 'Scan en cours...';
        status.className = 'status-badge running';
        
        console.log("Lancement du scan IP via POST...");
        try {
            // Construction propre de l'URL
            const url = (baseUrl + '/api/scan/ip/start').replace(/\/+/g, '/');
            
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Accept': 'application/json' }
            });
            
            if (!response.ok) {
                const text = await response.text();
                throw new Error(`Erreur ${response.status}: ${text.substring(0, 50)}`);
            }

            const result = await response.json();
            if (result.status !== 'ok') {
                throw new Error(result.message || 'Erreur inconnue');
            }
            console.log("Scan lancé avec succès");
        } catch (e) {
            console.error("Erreur scan:", e);
            alert('Erreur : ' + e.message);
            btn.disabled = false;
            status.textContent = 'Erreur';
            status.className = 'status-badge idle';
        }
    }

    async function editDevice(mac, ip) {
        const currentVendor = document.getElementById(`vendor-${mac}`).textContent;
        const newVendor = prompt(`Fabricant pour ${ip} (${mac}) :`, currentVendor);
        
        if (newVendor === null) return;
        
        const currentAnnots = document.getElementById(`annots-${mac}`).textContent;
        const annotStr = prompt(`Annotation (ex: "Pièce: Local Tech") :`, "");
        
        let annotations = null;
        if (annotStr) {
            const parts = annotStr.split(':');
            if (parts.length >= 2) {
                annotations = {};
                annotations[parts[0].trim()] = parts.slice(1).join(':').trim();
            }
        }

        try {
            const baseUrl = window.CONFIG ? window.CONFIG.baseUrl : '/rpinode';
            const url = (baseUrl + '/api/scan/ip/annotate').replace(/\/+/g, '/');
            
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    mac: mac,
                    vendor: newVendor,
                    annotations: annotations
                })
            });
            
            if (response.ok) {
                // Rafraîchissement local simple
                if (newVendor) document.getElementById(`vendor-${mac}`).textContent = newVendor;
                if (annotations) {
                    const container = document.getElementById(`annots-${mac}`);
                    for (const [k, v] of Object.entries(annotations)) {
                        const span = document.createElement('span');
                        span.className = 'annot-tag';
                        span.textContent = `${k}: ${v}`;
                        container.appendChild(span);
                    }
                }
                
                // Afficher l'indicateur de synchro en attente
                const vendorCell = document.getElementById(`vendor-${mac}`).parentElement;
                if (!vendorCell.querySelector('.sync-pending')) {
                    const syncSpan = document.createElement('span');
                    syncSpan.className = 'sync-pending';
                    syncSpan.title = 'En attente de synchronisation';
                    syncSpan.textContent = '☁️';
                    vendorCell.appendChild(syncSpan);
                }
            } else {
                alert("Erreur lors de l'enregistrement");
            }
        } catch (e) {
            console.error(e);
            alert("Erreur réseau");
        }
    }
</script>

